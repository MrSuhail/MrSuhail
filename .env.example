# Copy to .env (or set these in your hosting dashboard) and fill in the blanks.

PORT=3000
ADMIN_API_KEY=                      # long random password for the staff page and admin API

# Store
STORE_NAME=Kauai Vincent Park
TIMEZONE=Africa/Johannesburg
CURRENCY_SYMBOL=R
TAX_RATE_BPS=1500                   # 15% VAT
PRICES_INCLUDE_TAX=true             # menu prices already include VAT
PAYMENT_NOTE=Please pay at the counter when you collect.
PREP_TIME_MINUTES=15
ORDER_CUTOFF_MINUTES=15

# WhatsApp (Meta WhatsApp Cloud API) — see "Connecting WhatsApp" in README.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=              # any random string; enter the same one in Meta's webhook settings
WHATSAPP_HANDOFF_HOURS=2
